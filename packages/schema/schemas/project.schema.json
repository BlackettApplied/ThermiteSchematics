{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thermiteschematics.com/schemas/0.1/project.schema.json",
  "title": "ProjectManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "project", "sources"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "presentation": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?![\\s\\S]*\\\\)(?!\\.{1,2}(?:/|$))(?![\\s\\S]*/\\.{1,2}(?:/|$))[^\\u0000-\\u001f\\u007f-\\u009f/]+(?:/[^\\u0000-\\u001f\\u007f-\\u009f/]+)*$"
    },
    "libraries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?![\\s\\S]*\\\\)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          }
        }
      }
    }
  }
}
