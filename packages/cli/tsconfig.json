{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "references": [
    { "path": "../agent-tools" },
    { "path": "../schema" },
    { "path": "../compiler" },
    { "path": "../query" },
    { "path": "../render" }
  ],
  "include": ["src/**/*.ts"]
}
