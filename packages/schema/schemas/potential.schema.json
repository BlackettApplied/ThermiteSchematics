{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thermiteschematics.com/schemas/0.1/potential.schema.json",
  "title": "Potential",
  "type": "object",
  "additionalProperties": false,
  "required": ["uid", "kind", "name", "at", "electrical"],
  "properties": {
    "uid": {
      "$ref": "https://thermiteschematics.com/schemas/0.1/common.schema.json#/$defs/uid"
    },
    "kind": {
      "const": "potential"
    },
    "designation": {
      "$ref": "https://thermiteschematics.com/schemas/0.1/common.schema.json#/$defs/designation"
    },
    "description": {
      "type": "string"
    },
    "aliases": {
      "$ref": "https://thermiteschematics.com/schemas/0.1/common.schema.json#/$defs/aliases"
    },
    "name": {
      "$ref": "https://thermiteschematics.com/schemas/0.1/common.schema.json#/$defs/designation"
    },
    "at": {
      "$ref": "https://thermiteschematics.com/schemas/0.1/common.schema.json#/$defs/terminalRef"
    },
    "electrical": {
      "$ref": "https://thermiteschematics.com/schemas/0.1/common.schema.json#/$defs/electricalIntent"
    }
  }
}
