{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One researched component proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "sourcePartId",
    "decision",
    "summary",
    "sources",
    "unresolved",
    "conformance"
  ],
  "properties": {
    "format": { "const": "thermite-component-candidate/0.1" },
    "sourcePartId": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["candidate", "needs-evidence"] },
    "summary": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "title",
          "revision",
          "pages",
          "authority",
          "claims",
          "diagramReviewed"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "title": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "minLength": 1 },
          "pages": { "type": "string", "minLength": 1 },
          "authority": { "enum": ["manufacturer", "manufacturer-mirror"] },
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "diagramReviewed": { "type": "boolean" }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "conformance": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "terminalKeys",
            "requiredTerminalKeys",
            "fixedLinks",
            "renderKind"
          ],
          "properties": {
            "terminalKeys": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "requiredTerminalKeys": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "renderKind": { "enum": ["circuit", "accessory", "overview"] },
            "fixedLinks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to", "sourceId", "reason"],
                "properties": {
                  "from": { "type": "string", "minLength": 1 },
                  "to": { "type": "string", "minLength": 1 },
                  "sourceId": { "type": "string", "minLength": 1 },
                  "reason": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      ]
    }
  }
}
