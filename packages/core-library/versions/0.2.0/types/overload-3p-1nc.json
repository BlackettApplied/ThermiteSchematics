{
  "$schema": "https://thermiteschematics.com/schemas/0.1/library-file.schema.json",
  "types": [
    {
      "kind": "device_type",
      "id": "core:overload-3p-1nc",
      "description": "Three-pole overload relay with one NC auxiliary contact",
      "terminals": {
        "1/L1": {
          "role": "power_input"
        },
        "2/T1": {
          "role": "power_output"
        },
        "3/L2": {
          "role": "power_input"
        },
        "4/T2": {
          "role": "power_output"
        },
        "5/L3": {
          "role": "power_input"
        },
        "6/T3": {
          "role": "power_output"
        },
        "95": {
          "role": "aux",
          "required": true
        },
        "96": {
          "role": "aux",
          "required": true
        }
      },
      "functions": {
        "pole1": {
          "kind": "contact",
          "normal_state": "closed",
          "terminals": ["1/L1", "2/T1"]
        },
        "pole2": {
          "kind": "contact",
          "normal_state": "closed",
          "terminals": ["3/L2", "4/T2"]
        },
        "pole3": {
          "kind": "contact",
          "normal_state": "closed",
          "terminals": ["5/L3", "6/T3"]
        },
        "aux95": {
          "kind": "contact",
          "normal_state": "closed",
          "terminals": ["95", "96"]
        },
        "trip": {
          "kind": "mechanism",
          "terminals": []
        }
      },
      "internal_relations": [
        {
          "relation": "trips",
          "from": "trip",
          "to": "aux95"
        }
      ],
      "symbol": "thermite:overload",
      "connectionCoverage": {
        "status": "generic",
        "notes": "Reviewed generic interface: Three power input/output pole pairs, NC auxiliary 95/96 and a terminal-free trip mechanism are modeled. Power pole use is application-dependent; require each used pair in the project. Terminals 95/96 are required: the trip contact is the only modeled output; unwired, the overload cannot interrupt its load. Unmodeled: extra alarm/reset contacts, electronics and bonding of actual overload relays; protective suitability is not established."
      }
    }
  ]
}
