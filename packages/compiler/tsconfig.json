{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "references": [{ "path": "../core-library" }, { "path": "../schema" }],
  "include": ["src/**/*.ts"]
}
