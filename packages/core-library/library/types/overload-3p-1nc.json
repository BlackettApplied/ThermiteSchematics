{
  "$schema": "https://thermiteschematics.com/schemas/0.1/library-file.schema.json",
  "types": [
    {
      "kind": "device_type",
      "id": "core:overload-3p-1nc",
      "description": "Three-pole overload relay with one NC auxiliary contact",
      "terminals": {
        "1/L1": { "role": "power_input" },
        "2/T1": { "role": "power_output" },
        "3/L2": { "role": "power_input" },
        "4/T2": { "role": "power_output" },
        "5/L3": { "role": "power_input" },
        "6/T3": { "role": "power_output" },
        "95": { "role": "aux" },
        "96": { "role": "aux" }
      },
      "functions": {
        "pole1": {
          "kind": "contact",
          "normal_state": "closed",
          "terminals": ["1/L1", "2/T1"]
        },
        "pole2": {
          "kind": "contact",
          "normal_state": "closed",
          "terminals": ["3/L2", "4/T2"]
        },
        "pole3": {
          "kind": "contact",
          "normal_state": "closed",
          "terminals": ["5/L3", "6/T3"]
        },
        "aux95": {
          "kind": "contact",
          "normal_state": "closed",
          "terminals": ["95", "96"]
        },
        "trip": { "kind": "mechanism", "terminals": [] }
      },
      "internal_relations": [
        { "relation": "trips", "from": "trip", "to": "aux95" }
      ],
      "symbol": "iec:overload-relay"
    }
  ]
}
