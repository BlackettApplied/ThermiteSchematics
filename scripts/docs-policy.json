{
  "exclude": {
    "directoryNames": [
      ".git",
      "node_modules",
      "dist",
      "build",
      "coverage",
      ".npm-cache",
      ".codex-reviews",
      ".claude",
      ".codex",
      ".vscode",
      ".idea"
    ],
    "prefixes": [
      "docs/planning",
      "evals/out",
      "packages/cli/assets/guide",
      "target",
      "native-out",
      "alpha-out",
      "output",
      "tmp",
      ".verification-work",
      "release-out",
      "projects",
      "examples/legacy-cad-examples"
    ],
    "files": ["PR.md"],
    "patterns": ["^examples/[^/]+/out(?:/|$)"]
  },
  "groups": [
    {
      "title": "Start and contribute",
      "pattern": "^[^/]+\\.md$"
    },
    {
      "title": "Guide topics",
      "topics": true
    },
    {
      "title": "Other references",
      "pattern": "^(?!.*(?:^|/)fixtures/)docs/(?!legacy/)"
    },
    {
      "title": "Packages",
      "pattern": "^(?!packages/cli/assets/AGENTS\\.md$)(?!.*(?:^|/)fixtures/)packages/"
    },
    {
      "title": "Examples",
      "pattern": "^(?!.*(?:^|/)fixtures/)examples/"
    },
    {
      "title": "Libraries and research",
      "pattern": "^(?!.*(?:^|/)fixtures/)libraries/",
      "collapsible": true,
      "byLibrary": true
    },
    {
      "title": "Evaluations, tooling and fixtures",
      "pattern": "^(?!docs/legacy/)(?!packages/cli/assets/AGENTS\\.md$)",
      "collapsible": true
    },
    {
      "title": "Archive",
      "pattern": "^(?:docs/legacy/|packages/cli/assets/AGENTS\\.md$)",
      "collapsible": true
    }
  ],
  "legacy": {
    "frozenFile": "packages/cli/assets/AGENTS.md",
    "frozenSha256": "5e1ec3a4d465ba2eb85d2bbe9ac802f17212f77711763a547cfe403f5a499a49",
    "patterns": [
      "Historical private 0\\.2\\.0 runtime",
      "npm\\s+(?:install|i)\\b[^\\n]*(?:--global\\b|(?<!\\S)-g\\b)",
      "thermite-cli-0\\.2\\.0\\.tgz",
      "\\^22\\.12\\.0",
      "thermite init.*My First Electrical Project",
      "\\brequires?[ \\t]+Node(?:\\.js)?[ \\t]+(?:>=[ \\t]*)?[`^~v]*22\\.12(?:\\.0)?\\b",
      "\\bpnpm\\s+(?:add|install)\\b[^\\n]*(?:--global\\b|(?<!\\S)-g\\b)",
      "\\bnpm\\s+run\\s+test:legacy-package\\b",
      "Historical private 0\\.2\\.0 packaging",
      "thermite init`?\\s+(?:always targets|targeted)\\s+the\\s+current\\s+(?:existing|empty)\\b",
      "\\bhas no path operand\\b",
      "^#{1,6}[ \\t]+Private offline install[ \\t]*$",
      "\\bObtain the authorized private Release assets\\b",
      "\\b(?:isolated-prefix|empty-user-npmrc|empty-global-npmrc|Create a new isolated prefix)\\b",
      "\\bInvoke only the `?thermite`? shim installed under that prefix\\b",
      "\\bThe version output is `0\\.2\\.0`",
      "\\bname `Thermite Schematics Starter Project` and revision `0\\.1\\.0`",
      "\\bbun\\s+add\\b[^\\n]*(?:--global\\b|(?<!\\S)-g\\b)",
      "\\byarn\\s+global\\s+add\\b"
    ],
    "baseline": []
  }
}
