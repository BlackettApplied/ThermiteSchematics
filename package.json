{
  "name": "thermite-schematics",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build": "bun --bun tsc -b && bun scripts/build-guide.mjs",
    "test": "bun scripts/test.mjs",
    "release:pack": "bash scripts/release-pack.sh",
    "release:accept": "node scripts/release-acceptance.mjs",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "check:committed-json": "bun scripts/assert-prettier-stable-json.mjs",
    "check": "bun run generate:types:check && bun run build && bun run check:text-metrics && bun run check:health && bun run check:docs && bun run test && bun run format:check && bun run check:committed-json",
    "generate:types": "bun run --cwd packages/schema generate:types",
    "generate:types:check": "bun run --cwd packages/schema generate:types:check",
    "test:release-evidence": "node scripts/run-vitest-and-audit.mjs && node packages/cli/dist/bin.js validate \"packages/cli/fixtures/valid project\" --json",
    "thermite": "bun thermite.mjs",
    "setup": "bun install --frozen-lockfile && bun run build",
    "alpha:pack": "bun scripts/pack-alpha.mjs",
    "test:legacy-package": "node scripts/test.mjs packages/cli/test/release-package.test.ts",
    "demo:machine": "bun scripts/demo-machine.mjs",
    "demo:change": "bun scripts/demo-change.mjs",
    "package:pack": "bun scripts/runtime-package/pack.mjs",
    "package:verify": "bun scripts/runtime-package/verify.mjs",
    "check:linux": "bun scripts/platform/check-linux.mjs",
    "check:text-metrics": "bun scripts/update-text-metrics.mjs --check",
    "check:health": "bun scripts/health-ratchet.mjs",
    "health:lower": "bun scripts/health-ratchet.mjs --lower",
    "test:catalog": "bun scripts/test-catalog.mjs",
    "health:accept": "bun scripts/health-ratchet.mjs --accept",
    "check:docs": "bun scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@types/fontkit": "^2.0.8",
    "@types/node": "^22.20.1",
    "@types/pdfkit": "^0.17.3",
    "@types/svg-to-pdfkit": "^0.1.4",
    "dejavu-fonts-ttf": "2.37.3",
    "github-slugger": "^2.0.0",
    "linkedom": "^0.18.12",
    "mdast-util-from-markdown": "^2.1.0",
    "pdfjs-dist": "^6.5.438",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
